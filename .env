# Local secrets — DO NOT COMMIT (this file is gitignored).
# Mirror these in Vercel → Project → Settings → Environment Variables.

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# Common fallback chat id — REQUIRED for anything to be delivered.
# Get it from @getmyid_bot / @RawDataBot (groups/channels start with -100...).
TELEGRAM_CHAT_ID=

# Optional per-branch chat ids (fall back to TELEGRAM_CHAT_ID when empty):
TELEGRAM_NURSAT_CHAT_ID=
TELEGRAM_TAUKE_HANA_CHAT_ID=
TELEGRAM_ASTANA_CHAT_ID=
TELEGRAM_TARAZ_CHAT_ID=
TELEGRAM_AKTOBE_CHAT_ID=
TELEGRAM_TULPAR_CHAT_ID=
TELEGRAM_KUNAEVA_CHAT_ID=
TELEGRAM_FRANCHISE_CHAT_ID=

# ─── Bitrix24 (separate integration) ─────────────────────────────────────────
BITRIX_WEBHOOK=

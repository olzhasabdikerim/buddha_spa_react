# Environment variables for the /api serverless functions (Vercel).
# Copy the keys into Vercel → Project → Settings → Environment Variables.
# NEVER commit real values to git. The bot token stays server-side only.

# ─── Telegram ────────────────────────────────────────────────────────────────

# Token of Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=

# Target chat/group/channel ID (common fallback used when a branch has no own chat)
TELEGRAM_CHAT_ID=

# Optional per-branch chat IDs. None are required — any branch without its own
# ID falls back to TELEGRAM_CHAT_ID above. Group/channel IDs start with -100...
TELEGRAM_NURSAT_CHAT_ID=
TELEGRAM_TAUKE_HANA_CHAT_ID=
TELEGRAM_ASTANA_CHAT_ID=
TELEGRAM_TARAZ_CHAT_ID=
TELEGRAM_AKTOBE_CHAT_ID=
# Extra branches supported by the code (optional):
TELEGRAM_TULPAR_CHAT_ID=
TELEGRAM_KUNAEVA_CHAT_ID=
TELEGRAM_FRANCHISE_CHAT_ID=

# ─── Bitrix24 (separate integration — leave as is) ───────────────────────────

# Bitrix24 incoming webhook base URL (single common funnel).
# Get it in Bitrix24: Developer resources → Other → Inbound webhook (crm.lead.add).
BITRIX_WEBHOOK=
